# 复制为 .env 并填入真实值。.env 不会提交。
# OIDC login for the panel, shared by the LiveWireGuard import endpoint.
# Every OAUTH_OIDC_* value can be overridden at runtime in Admin Panel -> OIDC
# (empty fields there fall back to these values).
# Register http://localhost:51821/api/auth/oidc/callback and
# http://localhost:51821/api/auth/oidc/link in your IdP first.
OAUTH_PROVIDERS=oidc
OAUTH_OIDC_SERVER=https://your-idp.example.com/application/o/wg-easy/
OAUTH_OIDC_CLIENT_ID=wg-easy-client
OAUTH_OIDC_CLIENT_SECRET=your-client-secret
OAUTH_AUTO_REGISTER=true

# INIT 面板初始密码
INIT_PASSWORD=Qweasdyxcv!2

WG_EASY_IMAGE=ghcr.io/wg-easy/wg-easy:15