# 复制为 .env 后修改：cp .env.example .env && chmod 600 .env（里面有云 API 密钥）

# 浏览器访问 Web UI 用的公网 IP 或域名（不带协议和端口）
# http / tencentcloud / alidns 模式必须是域名
WG_WEB_HOST=1.2.3.4

# ---------- 证书模式 ----------
#   internal      -> Caddy 自建 CA 自动签发（IP 或内网均可，浏览器需导入根证书才不告警）
#   http          -> Let's Encrypt 正式证书，HTTP-01 验证（域名解析到本机 + 80/tcp 公网可达）
#   tencentcloud  -> Let's Encrypt 正式证书，DNS-01 验证，腾讯云 DNSPod 托管的域名（不需要 80 端口）
#   alidns        -> Let's Encrypt 正式证书，DNS-01 验证，阿里云解析托管的域名（不需要 80 端口）
CADDY_TLS_MODE=internal

# 证书到期提醒和 ACME 账号用的邮箱（http / DNS 模式建议填写）
ACME_EMAIL=

# DNS 模式检查 TXT 记录是否生效时用的解析服务器，空格分隔
CADDY_DNS_RESOLVERS=119.29.29.29 223.5.5.5

# ---------- DNS 验证密钥（只填所选模式那一组）----------
# 腾讯云：CAM 子账号的 API 密钥，只授权云解析 DNSPod 的权限
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
# 阿里云：RAM 子账号的 AccessKey，只授权云解析 DNS 的权限
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=

# ---------- 安全加固 ----------
# 允许访问 Web UI 的来源 IP/CIDR，空格分隔；默认不限制
# 例：WG_ALLOW_IPS=203.0.113.10/32 198.51.100.0/24 2001:db8::/48
WG_ALLOW_IPS=0.0.0.0/0 ::/0

# HSTS：正式证书（域名）稳定运行后改为 max-age=31536000
# internal 证书且客户端未导入根证书时保持 max-age=0
CADDY_HSTS=max-age=0

# 登录 / 2FA 限流（每个 IP，IPv6 按 /64）
RL_LOGIN_PER_MIN=5
RL_LOGIN_PER_HOUR=30

# ---------- CrowdSec 自动封禁 ----------
# caddy 与 crowdsec 之间的通信密钥（必填），生成：openssl rand -hex 32
# 只用字母和数字。首次启动后再修改，需先执行：
#   docker exec wg-easy-crowdsec cscli bouncers delete caddy
# 然后重启两个容器
CROWDSEC_BOUNCER_KEY=

# true = 纯本地运行，不连 CrowdSec 中央 API（不接收社区黑名单）
CROWDSEC_DISABLE_ONLINE_API=false

# 可选：app.crowdsec.net 控制台的注册密钥
CROWDSEC_ENROLL_KEY=

# CrowdSec 镜像，默认 Docker Hub 上的固定版本
# 连不上 Docker Hub 时先运行 scripts/mirror-images.sh，再改为：
#   CROWDSEC_IMAGE=ccr.ccs.tencentyun.com/vpn-server/crowdsec:v1.8.2
CROWDSEC_IMAGE=crowdsecurity/crowdsec:v1.8.2

# ---------- 封禁通知 ----------
# 推送渠道：留空 = 不推送；wecom（企业微信）| dingtalk（钉钉）| telegram
# 只推送 wg-easy 专用规则的封禁；2FA 爆破标为高危并 @所有人
# 修改后执行：docker compose -f docker-compose-dirty.yml up -d crowdsec
CROWDSEC_NOTIFY=

# 只填所选渠道的那一项
# 企业微信群机器人：webhook 地址里 key= 后面的部分
NOTIFY_WECOM_KEY=
# 钉钉群机器人：webhook 地址里 access_token= 后面的部分；安全设置选“自定义关键词”，填 wg-easy
NOTIFY_DINGTALK_TOKEN=
# Telegram：@BotFather 给的 bot token，以及接收消息的 chat id
NOTIFY_TELEGRAM_TOKEN=
NOTIFY_TELEGRAM_CHAT_ID=

# ---------- 构建 ----------
# DNS 插件和最新 Caddy 不兼容导致编译失败时，固定到较早的小版本，如 2.9
CADDY_VERSION=2

# 编译 Caddy 用的基础镜像前缀，留空 = Docker Hub；末尾带 /
# 连不上 Docker Hub 时先运行 scripts/mirror-images.sh，再改为：
#   CADDY_BASE_REGISTRY=ccr.ccs.tencentyun.com/vpn-server/
CADDY_BASE_REGISTRY=

# scripts/mirror-images.sh：同步到哪里、同步哪个 CrowdSec 版本
MIRROR_NAMESPACE=ccr.ccs.tencentyun.com/vpn-server
CROWDSEC_VERSION=v1.8.2

# scripts/caddy-image.sh 的推送目标仓库
CADDY_IMAGE_REPO=ccr.ccs.tencentyun.com/vpn-server/caddy-ratelimit-dns

# 服务器直接拉取的镜像（留空 = 使用本地标签 / 现场编译）
# 建议填带日期的固定标签，而不是 latest，便于回滚
# 例：CADDY_IMAGE=ccr.ccs.tencentyun.com/vpn-server/caddy-ratelimit-dns:2.10.2-20261109-abc1234
CADDY_IMAGE=
